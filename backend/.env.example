# Copy this file to .env and fill in your own values. Never commit .env.
# Get the connection string from MongoDB Atlas: Database -> Connect -> Drivers.

# MongoDB Atlas connection string (keep the password secret!)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Local server port
PORT=3000

# Admin passcode (server-side auth). Required in production (set it in the
# Render dashboard as an environment variable, same as MONGODB_URI).
# The admin panel logs in via POST /api/admin/login and sends this value back
# in the x-admin-token header on admin writes. Keep it strong, keep it secret,
# and never commit the real value — .env is gitignored.
ADMIN_PASSCODE=your-strong-passcode
